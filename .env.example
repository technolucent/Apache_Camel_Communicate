# Copy to .env and fill in real values. .env is git-ignored.
# Used by docker-compose.yml and read by the app at startup.

# RabbitMQ broker credentials (used by both the rabbitmq service and camel-app)
RABBITMQ_USER=change-me-broker-user
RABBITMQ_PASS=change-me-broker-pass

# HTTP Basic auth for the Spring Boot app (actuator + API endpoints).
# The app fails fast at startup if these are blank.
APP_SECURITY_USERNAME=change-me-app-user
APP_SECURITY_PASSWORD=change-me-app-password
